# Single source of truth for every pinned version. Read by setup-wsl.sh (sourced)
# and by lemmata_mcp.common (parsed). Plain KEY=VALUE lines only.

# Lean side. Everything that loads Mathlib oleans must use this exact toolchain.
LEAN_TOOLCHAIN=leanprover/lean4:v4.35.0
MATHLIB_REV=v4.35.0
REPL_REV=v4.35.0
COMPARATOR_REV=v4.35.0
# lean4export is built as a comparator dependency at the revision comparator pins.

# Not built against our Mathlib: formal-conjectures pins Lean v4.33.1, so it is
# only searched as source text. See lemmata/README.md.
FORMAL_CONJECTURES_REV=ea8e3e198ded6fc73efb7f5653b74b28ac4ae1a8

# lean-lsp-mcp builds its own local Loogle for LEAN_TOOLCHAIN on first use.
LEAN_LSP_MCP_VERSION=0.33.0

# Sandbox used by comparator and by every process that runs worker-written code.
LANDRUN_REV=573aa723afb16bb1da2dbe24fc00df46cd0ad13b
GO_VERSION=go1.26.11

# SAT / graphs / CAS.
CADICAL_REV=rel-3.1.0
DRAT_TRIM_REV=2e3b2dc0ecf938addbd779d42877b6ed69d9a985
NAUTY_VERSION=2_9_3
SAGE_VERSION=10.10

# v2: Lean packages required (before Mathlib) by both the work and the verification
# project; the REPL header and every solution import them. All tag v4.35.0.
# LeanHammer brings Duper, lean-auto (+ Zipperposition binary), lean-smt and the cvc5 FFI.
HAMMER_REV=v4.35.0
LEANCERT_REV=v4.35.0

# v2: domain CAS and solvers. GAP (+ SmallGrp) and PARI/GP come with the Sage env.
LADR_REV=8317cb2dea069cd57723f76bdee7d6bd818103a7
CSDP_REV=releases/6.2.0
SOPLEX_VERSION=8.1.0
# Ubuntu 24.04 package, unpacked per-user (no sudo) with apt-get download + dpkg -x.
MACAULAY2_VERSION=1.22+ds-6build2
# Installed with pip into the Sage env (its verified routines need Sage).
SNAPPY_VERSION=3.3.2

# v2: candidate sources and batch checking.
PI_BASE_REV=c50a33cd1364a67c29cbe55ee153246f7dac5aa6
KIMINA_REV=fb2393de3461db35eda4c714e3fd21187e92ec90

# WSL distribution the Windows-side MCP launch commands target.
WSL_DISTRO=Ubuntu
