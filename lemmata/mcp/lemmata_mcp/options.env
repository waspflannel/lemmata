# lemmata runtime options, copied to $LEMMATA_HOME/options.env by `setup-wsl.sh options`
# and never overwritten there. Plain KEY=VALUE lines; restart the MCP servers after editing.

# Kimina Lean Server REPLs behind lean/batch_check. 0 = off: batch_check runs the snippets
# one after another on the lean server's warm REPL. Each Kimina REPL holds its own Mathlib +
# LeanHammer + LeanCert environment (several GB once warm), so with the 15 GB WSL default
# keep this at 2 or less, and at 0 while the local Loogle index builds (about 13 GB peak).
KIMINA_REPLS=0

# LeanSearch (leansearch.net) through lean-lsp-mcp's lean_leansearch tool. 0 = off: it sends
# queries off the machine, it is not one of the research sources, and it indexes a different
# Mathlib than the pinned one. If that is acceptable, set 1 and allowlist
# mcp__lean_lsp/lean_leansearch in the research profile only.
LEANSEARCH=0
